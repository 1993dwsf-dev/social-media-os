# Cloudflare Pages frontend variable. Use the SAME backend deployment as below.
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Convex backend-only environment variables. Never prefix secrets with VITE_.
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site
SOCIAL_MEDIA_OS_SIGNUP_CODE=

# Also configure JWT_PRIVATE_KEY and JWKS on Convex (Convex Auth setup).
# Deploy authorization belongs in GitHub Actions secret CONVEX_DEPLOY_KEY.
