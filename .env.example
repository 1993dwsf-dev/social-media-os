# Public frontend configuration for Cloudflare Pages.
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
VITE_SUPPORT_EMAIL=
VITE_OPERATOR_NAME=

# Backend only. Configure JWT_PRIVATE_KEY and JWKS with Convex Auth.
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site
# CONVEX_DEPLOY_KEY is private: production Pages secret_text, never VITE_.
# Invitations are issued individually via access:createInvite in Convex.
# Optional automatic invitation email; assisted delivery needs none of these.
# Backend-only Convex environment variables.
# Never put these values in VITE_*, GitHub, or the Pages frontend settings.
RESEND_API_KEY=
# Bare sender address on a verified Resend domain; no display name.
RESEND_FROM_EMAIL=
# Operator action: access:sendInvite, with { "email": "recipient@example.com" }.
